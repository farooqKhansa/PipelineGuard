# --- Core ---
ENV=development
DEMO_MODE=true
GATEWAY_VERSION=gw-0.4.2

# --- Database ---
# docker-compose sets this to postgres; local dev defaults to sqlite if unset.
DATABASE_URL=postgresql+psycopg2://pipelineguard:pipelineguard@localhost:5432/pipelineguard

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:3000

# --- Detection Core / Agentic Layer ---
# "external" preserves POST {DETECTION_CORE_URL}/detect.
# Set to "local_huggingface" only when the local model dependencies are installed.
DETECTION_PROVIDER=external
DETECTION_CORE_URL=
AGENTIC_LAYER_URL=
# Filesystem path containing the existing agent/ and audit/ packages.
AGENTIC_LAYER_PATH=
DETECTION_RISK_SCORE_SCALE=unknown
DETECTION_MODEL_ID=FaizaML/pipelineguard-codebert-risk
DETECTION_MODEL_INPUT_MODE=workflow_text
DETECTION_MODEL_MAX_LENGTH=512
DETECTION_MODEL_PADDING=max_length
DETECTION_MODEL_TRUNCATION=true
DETECTION_CLEAN_MAX_RISK=0.20
DETECTION_MALICIOUS_MIN_RISK=0.80
EXTERNAL_REQUEST_TIMEOUT_SECONDS=10
EXTERNAL_REQUEST_MAX_RETRIES=2

# --- GitHub ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

LOG_LEVEL=INFO
